diff --color -ruN c6/drivers/power/supply/erhai_pps.c c7/drivers/power/supply/erhai_pps.c
--- c6/drivers/power/supply/erhai_pps.c	2026-10-23 00:44:23.248797047 +0800
+++ c7/drivers/power/supply/erhai_pps.c	2026-10-23 00:44:23.269075166 +0800
@@ -639,7 +639,10 @@
 	rc = pps_batt_set(PPS_PROP_BATT_CHG_EN, erhai_otg_charge_inhibited() ? 0 : 1);
